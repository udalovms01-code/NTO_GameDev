  m_Script: {fileID: 11500000, guid: 56d58d68c37b92c4db408d8186167ca6, type: 3}
  m_Name: Day4
  m_EditorClassIdentifier: 
  nodes:
  - Guid: 10e7ef2a-a87e-4148-aaf7-c54d1f14fc21
    Text: "\u041F\u0440\u0438\u0437\u043D\u0430\u0439\u0441\u044F, \u0442\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u043C\u043E\u0438 \u0448\u0430\u0433\u0438 \u043F\u043E \u043F\u043E\u0442\u043E\u043B\u043A\u0443
      \u0442\u0432\u043E\u0438\u0445 \u0441\u043D\u043E\u0432? \u042F \u043F\u043B\u0435\u0442\u0443
      \u0432 \u043D\u0438\u0445 \u043F\u0430\u0443\u0442\u0438\u043D\u0443. \u041A\u0440\u0430\u0441\u0438\u0432\u043E
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F."
    LocalizationKey: dialogue_10e7ef2a-a87e-4148-aaf7-c54d1f14fc21
    OnEnter: {fileID: 0}
    Position: {x: 185.6, y: -898.4}
    Choices:
    - Text: "\u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0441\u043D\u043E\u0432.
        \u0422\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
      LocalizationKey: choice_10e7ef2a-a87e-4148-aaf7-c54d1f14fc21_0
      TargetNodeGuid: 466551b2-ae74-4452-a3d5-2a6f1bc42aca
    - Text: "\u0414\u0430\u2026 \u0422\u044B \u0441\u043D\u0438\u0448\u044C\u0441\u044F
        \u043C\u043D\u0435. \u041F\u0430\u0443\u0442\u0438\u043D\u0430\u2026 \u043E\u043D\u0430
        \u0434\u0443\u0448\u0438\u0442."
      LocalizationKey: choice_10e7ef2a-a87e-4148-aaf7-c54d1f14fc21_1
      TargetNodeGuid: 1daf5ab0-1fd3-4d9b-b46c-a4354b9a8555
  - Guid: 466551b2-ae74-4452-a3d5-2a6f1bc42aca
    Text: "\u0420\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C? \u042D\u0442\u0430
      \u0436\u0435\u043B\u0435\u0437\u043D\u0430\u044F \u043A\u043E\u0440\u043E\u0431\u043A\u0430?
      \u041D\u0435\u0442. \u0422\u0432\u043E\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u2014 \u044D\u0442\u043E \u0442\u043E, \u0447\u0442\u043E \u0442\u044B \u043D\u043E\u0441\u0438\u0448\u044C
      \u0432 \u0447\u0435\u0440\u0435\u043F\u0435. \u0410 \u044F \u0442\u0435\u043F\u0435\u0440\u044C
      \u0442\u0430\u043C \u0436\u0438\u0432\u0443. \u042F \u2014 \u043D\u043E\u0432\u044B\u0439
      \u0444\u0430\u043A\u0442 \u0442\u0432\u043E\u0435\u0439 \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438.
      \u0421\u0430\u043C\u044B\u0439 \u0432\u0430\u0436\u043D\u044B\u0439."
    LocalizationKey: dialogue_466551b2-ae74-4452-a3d5-2a6f1bc42aca
    OnEnter: {fileID: 0}
    Position: {x: 1136.8, y: -810.4}
    Choices:
    - Text: "\u042F \u043D\u0435 \u0431\u043E\u044E\u0441\u044C \u0442\u0435\u0431\u044F.
        \u042F \u0431\u043E\u044E\u0441\u044C \u043B\u044E\u0434\u0435\u0439."
      LocalizationKey: choice_466551b2-ae74-4452-a3d5-2a6f1bc42aca_0
      TargetNodeGuid: 54530b38-ce38-4b3c-8e99-efbeae67d24b
    - Text: "\u041C\u043E\u044F \u0436\u0438\u0437\u043D\u044C \u2014 \u043D\u0435
        \u043F\u0443\u0441\u0442\u043E\u0442\u0430."
      LocalizationKey: choice_466551b2-ae74-4452-a3d5-2a6f1bc42aca_1
      TargetNodeGuid: 34e888b0-c67e-4d1a-8660-a60778d472ff
  - Guid: 54530b38-ce38-4b3c-8e99-efbeae67d24b
    Text: "\u0412\u0435\u0440\u043D\u043E. \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
      \u043B\u044E\u0434\u0438 \u043C\u043E\u0433\u0443\u0442 \u043E\u0441\u0443\u0434\u0438\u0442\u044C.
      \u0410 \u044F? \u042F \u0443\u0436\u0435 \u0437\u043D\u0430\u044E \u043E\u0431\u043E
      \u0432\u0441\u0451\u043C. \u0418 \u043E\u0442 \u043C\u0435\u043D\u044F \u043D\u0435
      \u0441\u043F\u0440\u044F\u0447\u0435\u0448\u044C\u0441\u044F \u0437\u0430 \u043B\u0438\u0446\u0435\u043C\u0435\u0440\u043D\u044B\u043C
      \xAB\u043F\u0440\u043E\u0441\u0442\u0438\xBB. \u041F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u043D\u0435 \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u044F.
      \u042F \u2014 \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440. \u0418 \u0442\u0432\u043E\u0439
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u2014 \u043C\u043E\u044F \u0441\u043A\u0430\u043C\u044C\u044F
      \u043F\u043E\u0434\u0441\u0443\u0434\u0438\u043C\u044B\u0445. \u0421\u043A\u043E\u0440\u043E
      \u043C\u044B \u0432\u044B\u043D\u0435\u0441\u0435\u043C \u0432\u0435\u0440\u0434\u0438\u043A\u0442."
    LocalizationKey: dialogue_54530b38-ce38-4b3c-8e99-efbeae67d24b
    OnEnter: {fileID: 0}
    Position: {x: 2953.6, y: -523.2}
    Choices:
    - Text: ...
      LocalizationKey: choice_54530b38-ce38-4b3c-8e99-efbeae67d24b_0
      TargetNodeGuid: 
  - Guid: 34e888b0-c67e-4d1a-8660-a60778d472ff
    Text: "\u041D\u0435\u0442. \u041E\u043D\u0430 \u043F\u043E\u043B\u043D\u0430
      \u043E\u0434\u043D\u0438\u043C-\u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435\u043C.
      \u0418 \u044F \u043F\u043B\u0435\u0442\u0443\u0441\u044C \u0438\u0437 \u043D\u0435\u0433\u043E.
      \u0421\u043A\u043E\u0440\u043E \u043E\u043D\u043E \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442
      \u0432\u0441\u0451, \u0434\u0430\u0436\u0435 \u0438\u043B\u043B\u044E\u043C\u0438\u043D\u0430\u0442\u043E\u0440\u044B.
      \u0418 \u0442\u043E\u0433\u0434\u0430 \u0442\u044B \u0443\u0432\u0438\u0434\u0438\u0448\u044C
      \u043C\u0438\u0440 \u0442\u0430\u043A\u0438\u043C, \u043A\u0430\u043A\u0438\u043C
      \u0432\u0438\u0436\u0443 \u0435\u0433\u043E \u044F."
    LocalizationKey: dialogue_34e888b0-c67e-4d1a-8660-a60778d472ff
    OnEnter: {fileID: 0}
    Position: {x: 2540.8, y: -169.6}
    Choices:
    - Text: ...
      LocalizationKey: choice_34e888b0-c67e-4d1a-8660-a60778d472ff_0
      TargetNodeGuid: 
  - Guid: 1daf5ab0-1fd3-4d9b-b46c-a4354b9a8555
    Text: "\u0418 \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u0434\u043D\u0451\u043C
      \u0441\u043E\u043D \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u044F\u0441\u043D\u0435\u0435, \u0434\u0430? \u0422\u044B \u0443\u0436\u0435
      \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C \u0441\u0435\u0431\u044F
      \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u0434\u0430\u0436\u0435 \u0437\u0430 \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439
      \u0434\u0432\u0435\u0440\u044C\u044E. \u041D\u0435 \u0431\u043E\u0438\u0448\u044C\u0441\u044F,
      \u0447\u0442\u043E \u043D\u0430\u0448\u0430 \u0441\u0434\u0435\u043B\u043A\u0430
      \u0443\u0436\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A
      \u043A\u043E\u043D\u0446\u0443? \u0427\u0442\u043E \u0441\u043A\u043E\u0440\u043E
      \u043D\u0435 \u0440\u044B\u0431\u0443, \u0430 \u0442\u0435\u0431\u044F \u0441\u0430\u043C\u043E\u0433\u043E
      \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043A\u043B\u0430\u0441\u0442\u044C
      \u043D\u0430 \u0432\u0435\u0441\u044B?"
    LocalizationKey: dialogue_1daf5ab0-1fd3-4d9b-b46c-a4354b9a8555
    OnEnter: {fileID: 0}
    Position: {x: 430.4, y: -361.6}
    Choices:
    - Text: "\u0423 \u043D\u0430\u0441 \u0431\u044B\u043B\u0430 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0451\u043D\u043D\u043E\u0441\u0442\u044C!"
      LocalizationKey: choice_1daf5ab0-1fd3-4d9b-b46c-a4354b9a8555_0
      TargetNodeGuid: eb197434-4e6c-452f-863d-98475e670391
  - Guid: eb197434-4e6c-452f-863d-98475e670391
    Text: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0451\u043D\u043D\u043E\u0441\u0442\u0438
      \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u044E\u0442 \u043C\u0435\u0436 \u0434\u0432\u0443\u0445
      \u0440\u0430\u0437\u043D\u044B\u0445 \u0441\u0442\u043E\u0440\u043E\u043D.
      \u0421\u043A\u043E\u0440\u043E \u043C\u044B \u0441\u0442\u0430\u043D\u0435\u043C
      \u043E\u0434\u043D\u0438\u043C \u0446\u0435\u043B\u044B\u043C. \u041A\u043E\u0440\u0430\u0431\u043B\u044C
      \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438 \u043C\u043E\u0439. \u041A\u0443\u0434\u0430
      \u043F\u043E\u0431\u0435\u0436\u0438\u0448\u044C \u0442\u043E\u0433\u0434\u0430,
      \u0440\u044B\u0431\u0430\u043A? \u0412 \u043E\u043A\u0435\u0430\u043D? \u041E\u043D
      \u043C\u043E\u0439. \u0412 \u043D\u0435\u0431\u043E? \u041E\u043D\u043E \u043C\u043E\u0451.
      \u041E\u0441\u0442\u0430\u043D\u0435\u0448\u044C\u0441\u044F \u043E\u0434\u043D\u0430\u0436\u0434\u044B
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u043F\u043E\u043B\u043D\u044B\u043C \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435\u043C.
      \u0416\u0434\u0443 \u043D\u0435 \u0434\u043E\u0436\u0434\u0443\u0441\u044C."
    LocalizationKey: dialogue_eb197434-4e6c-452f-863d-98475e670391
    OnEnter: {fileID: 0}
    Position: {x: 2121.6, y: 244.8}
    Choices:
