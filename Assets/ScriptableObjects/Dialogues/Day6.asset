    Text: "\u0412\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
      \u0441\u0442\u0443\u043A \u0433\u0440\u043E\u043C\u043A\u0438\u0439 \u0441\u0442\u0443\u043A
      \u0441\u0435\u0440\u0434\u0446\u0430. \u0412\u044B \u043E\u0441\u043E\u0437\u043D\u0430\u0451\u0442\u0435,
      \u0447\u0442\u043E \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0435 \u0441\u043B\u0438\u043B\u043E\u0441\u044C
      \u0441 \u0432\u0430\u0448\u0438\u043C \u0441\u0443\u0434\u043D\u043E\u043C,
      \u0438 \u0412\u0430\u0441 \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u043D\u0435\u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0438\u043C\u0430\u044F
      \u0442\u0440\u0435\u0432\u043E\u0433\u0430. \u0420\u0435\u0448\u0438\u0442\u0435\u0441\u044C
      \u043B\u0438 \u0432\u044B \u043D\u0430 \u043F\u043E\u043F\u044B\u0442\u043A\u0443?"
