  nodes:
  - Guid: 69b461bd-1fb0-4b2b-9710-d28617fc7f7b
    Text: "\u0420\u0443\u043A\u0438. \u0427\u0442\u043E\u0431\u044B \u0434\u0435\u0440\u0436\u0430\u0442\u044C.
      \u0427\u0442\u043E\u0431\u044B \u0445\u0432\u0430\u0442\u0430\u0442\u044C.
      \u0427\u0442\u043E\u0431\u044B \u043D\u0435 \u0434\u0430\u0442\u044C \u0443\u0439\u0442\u0438.
      \u0423\u0434\u043E\u0431\u043D\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?
      \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043C\u043E\u0433\u0443 \u0441\u0442\u0443\u0447\u0430\u0442\u044C
      \u0432 \u0442\u0432\u043E\u044E \u0434\u0432\u0435\u0440\u044C. \u041D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0442\u0443, \u0436\u0435\u043B\u0435\u0437\u043D\u0443\u044E."
    LocalizationKey: dialogue_69b461bd-1fb0-4b2b-9710-d28617fc7f7b
    OnEnter: {fileID: 0}
    Position: {x: 152.8, y: -363.2}
    Choices:
    - Text: "\u0422\u044B \u043D\u0435 \u043F\u043E\u0441\u043C\u0435\u0435\u0448\u044C
        \u0432\u043E\u0439\u0442\u0438."
      LocalizationKey: 
      TargetNodeGuid: c822b1f0-1c32-49f5-b746-94683943dcb0
    - Text: "\u0427\u0442\u043E \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C
        \u043E\u0442 \u043C\u0435\u043D\u044F \u043D\u0430\u0439\u0442\u0438?"
      LocalizationKey: 
      TargetNodeGuid: 6bcaba5a-190b-4a51-a621-c2f40216193a
  - Guid: c822b1f0-1c32-49f5-b746-94683943dcb0
    Text: "\u042F \u0443\u0436\u0435 \u0432\u043D\u0443\u0442\u0440\u0438. \u042F
      \u0441\u0442\u0443\u0447\u0443\u0441\u044C \u0432 \u0442\u0432\u043E\u044E
      \u043F\u0430\u043C\u044F\u0442\u044C. \u0418 \u0434\u0432\u0435\u0440\u044C
      \u0442\u0430\u043C\u2026 \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435
      \u043A\u0440\u0435\u043F\u043A\u0430\u044F. \u041F\u0430\u0445\u043D\u0435\u0442
      \u0441\u0442\u0430\u0440\u043E\u0439 \u0440\u0436\u0430\u0432\u0447\u0438\u043D\u043E\u0439
      \u0438\u2026 \u0441\u0442\u0440\u0430\u0445\u043E\u043C. \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
      \u0447\u0435\u0439 \u043E\u043D?"
    LocalizationKey: dialogue_c822b1f0-1c32-49f5-b746-94683943dcb0
    OnEnter: {fileID: 0}
    Position: {x: 926.4, y: -519.2}
    Choices:
    - Text: "\u0414\u0430\u043B\u044C\u0448\u0435..."
      LocalizationKey: 
      TargetNodeGuid: 
  - Guid: 6bcaba5a-190b-4a51-a621-c2f40216193a
    Text: "\u041D\u0435 \xAB\u0447\u0442\u043E\xBB, \u0430 \xAB\u043A\u043E\u0433\u043E\xBB.
      \u0422\u043E\u0433\u043E, \u043A\u0435\u043C \u0442\u044B \u0431\u044B\u043B
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0441\u0442\u0430\u043B
      \u044D\u0442\u0438\u043C \u043F\u0443\u0441\u0442\u044B\u043C \u043C\u0435\u0441\u0442\u043E\u043C
      \u0432 \u043A\u0430\u044E\u0442\u0435. \u041E\u043D \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0441\u044F
      \u043E\u0447\u0435\u043D\u044C \u0433\u043B\u0443\u0431\u043E\u043A\u043E.
      \u041D\u043E \u044F \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u043A\u043E\u043F\u0430\u0442\u0435\u043B\u044C."
    LocalizationKey: dialogue_6bcaba5a-190b-4a51-a621-c2f40216193a
    OnEnter: {fileID: 0}
    Position: {x: 902.4, y: -172}
    Choices:
    - Text: "\u0422\u0430\u043C \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435\u0442."
      LocalizationKey: 
      TargetNodeGuid: b639026e-7d17-49d0-a7d4-2e315a159e42
    - Text: "\u041E\u0441\u0442\u0430\u0432\u044C \u0435\u0433\u043E \u0432 \u043F\u043E\u043A\u043E\u0435."
      LocalizationKey: 
      TargetNodeGuid: ae0cf85d-5f51-4533-b7e3-265476589923
  - Guid: b639026e-7d17-49d0-a7d4-2e315a159e42
    Text: "\u0412\u0441\u0435 \u0442\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u044F\u0442.
      \u0410 \u043F\u043E\u0442\u043E\u043C \u0440\u044B\u0434\u0430\u044E\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u044F \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E
      \u0438\u043C \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438.
      \u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F, \u044F \u0441\u043A\u043E\u0440\u043E
      \u043D\u0430\u0439\u0434\u0443 \u0442\u0432\u043E\u0439 \u0430\u043B\u044C\u0431\u043E\u043C."
    LocalizationKey: dialogue_b639026e-7d17-49d0-a7d4-2e315a159e42
    OnEnter: {fileID: 0}
    Position: {x: 1680, y: -296}
    Choices:
    - Text: ...
      LocalizationKey: 
      TargetNodeGuid: 
  - Guid: ae0cf85d-5f51-4533-b7e3-265476589923
    Text: "\u0410\u0433\u0430! \u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u044B
      \u0435\u0433\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0448\u044C!
      \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C \u043E\u0431\u0449\u0438\u0439
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439. \u0417\u0430\u0432\u0442\u0440\u0430
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C \u043E \u043D\u0451\u043C
      \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435. \u041F\u0440\u0438\u043D\u0435\u0441\u0438
      \u0440\u044B\u0431\u044B."
    LocalizationKey: dialogue_ae0cf85d-5f51-4533-b7e3-265476589923
    OnEnter: {fileID: 0}
    Position: {x: 1672, y: 48}
    Choices:
    - Text: ...
      LocalizationKey: 
