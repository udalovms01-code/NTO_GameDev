  nodes:
  - Guid: 343ab518-29d8-40d1-aa2d-48e110c28409
    Text: "\u041C\u043E\u043D\u0441\u0442\u0440 (\u0433\u043E\u043B\u043E\u0441 \u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0441\u043E \u0432\u0441\u0435\u0445 \u0441\u0442\u043E\u0440\u043E\u043D):
      \xAB\u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u043F\u043E\u0447\u0435\u043C\u0443
      \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0449\u0438\u0435 \u043C\u0438\u043C\u043E
      \u0441\u0443\u0434\u043D\u0430 \u043E\u0433\u0438\u0431\u0430\u044E\u0442 \u043D\u0430\u0441
      \u0437\u0430 \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440?\xBB"
    LocalizationKey: dialogue_343ab518-29d8-40d1-aa2d-48e110c28409
    OnEnter: {fileID: 0}
    Position: {x: 151.2, y: -857.60004}
    Choices:
    - Text: "\u041E\u0442\u043A\u0443\u0434\u0430 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C?"
      LocalizationKey: choice_343ab518-29d8-40d1-aa2d-48e110c28409_0
      TargetNodeGuid: 
  - Guid: 77c359a6-aac8-4eae-9649-0d6be503613b
    Text: "\u041C\u043E\u044F \u043F\u043B\u043E\u0442\u044C \u0443\u0436\u0435 \u043F\u043E\u0432\u0441\u044E\u0434\u0443.
      \u042F \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E
      \u0448\u0442\u0443\u0440\u0432\u0430\u043B, \u043D\u043E \u0438 \u0441\u043B\u0435\u0436\u0443
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u043C \u0448\u043E\u0440\u043E\u0445\u043E\u043C
      \u043D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u0435, \u0432 \u0442\u043E\u043C
      \u0447\u0438\u0441\u043B\u0435 \u0438 \u043E\u0442 \u0442\u0435\u0431\u044F.
      \u0412\u0438\u0436\u0443 \u0442\u0435\u0431\u044F \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C.
      \u0412\u0438\u0436\u0443 \u0442\u0443 \u0441\u0442\u0430\u0440\u0443\u044E
      \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044E, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0442\u044B \u043F\u0440\u044F\u0447\u0435\u0448\u044C \u043F\u043E\u0434
      \u043C\u0430\u0442\u0440\u0430\u0441\u043E\u043C. \u0423\u043B\u044B\u0431\u0430\u044E\u0442\u0441\u044F
      \u0442\u0430\u043A\u0438\u0435..."
    LocalizationKey: dialogue_77c359a6-aac8-4eae-9649-0d6be503613b
    OnEnter: {fileID: 0}
    Position: {x: 910.4, y: -405.6}
    Choices:
    - Text: "\u0427\u0442\u043E \u0434\u0430\u043B\u044C\u0448\u0435?"
      LocalizationKey: choice_77c359a6-aac8-4eae-9649-0d6be503613b_0
      TargetNodeGuid: 
    - Text: "\u0422\u043E\u0433\u0434\u0430 \u0441\u043A\u0430\u0436\u0438, \u0447\u0442\u043E
        \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0439\u0447\u0430\u0441."
      LocalizationKey: choice_77c359a6-aac8-4eae-9649-0d6be503613b_1
      TargetNodeGuid: 
    - Text: "\u0410 \u043A\u0430\u043A \u0436\u0435 \u043D\u0430\u0448\u0430 \u0441\u0434\u0435\u043B\u043A\u0430?"
      LocalizationKey: choice_77c359a6-aac8-4eae-9649-0d6be503613b_2
      TargetNodeGuid: 
  - Guid: f582c528-326c-4085-959a-958d27b3a9bc
    Text: "\u0414\u0430\u043B\u044C\u0448\u0435? \u0414\u0430\u043B\u044C\u0448\u0435
      \u2014 \u0430\u0441\u0441\u0438\u043C\u0438\u043B\u044F\u0446\u0438\u044F.
      \u0422\u044B \u043A\u043E\u0440\u043C\u0438\u043B \u043C\u0435\u043D\u044F,
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0436\u0438\u0442\u044C. \u0410
      \u044F \u0435\u043B, \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0430\u0442\u044C
      \u0442\u043E\u0431\u043E\u0439. \u0422\u0432\u043E\u0438 \u0441\u0442\u0440\u0430\u0445\u0438,
      \u0442\u0432\u043E\u044F \u0432\u0438\u043D\u0430 \u2014 \u043C\u043E\u0439
      \u043B\u0443\u0447\u0448\u0438\u0439 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B. \u0421\u043A\u043E\u0440\u043E
      \u043C\u0435\u0436\u0434\u0443 \xAB\u043C\u043D\u043E\u0439\xBB \u0438 \xAB\u0442\u043E\u0431\u043E\u0439\xBB
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u043A\u0438.
      \u0422\u044B \u0441\u0442\u0430\u043D\u0435\u0448\u044C \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u0435\u043C
      \u0432 \u043C\u0443\u0437\u0435\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u0433\u0438\u0431\u0435\u043B\u0438."
    LocalizationKey: dialogue_f582c528-326c-4085-959a-958d27b3a9bc
    OnEnter: {fileID: 0}
    Position: {x: 2909.6, y: -282.4}
    Choices:
    - Text: "\u0410 \u043A\u0430\u043A \u0436\u0435 \u043D\u0430\u0448\u0430 \u0441\u0434\u0435\u043B\u043A\u0430?"
      LocalizationKey: choice_f582c528-326c-4085-959a-958d27b3a9bc_0
      TargetNodeGuid: 
    - Text: ...
      LocalizationKey: choice_f582c528-326c-4085-959a-958d27b3a9bc_1
      TargetNodeGuid: 
  - Guid: 76b1aeff-df8b-4127-b85c-46af9de67d56
    Text: "\u041C\u043E\u043D\u0441\u0442\u0440 (\u043F\u043E\u0441\u043B\u0435 \u043F\u0430\u0443\u0437\u044B):
      \xAB\u041E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E. \u041D\u0435
      \u0442\u043E\u0441\u043A\u0443 \u043F\u043E \u043B\u044E\u0434\u044F\u043C.
      \u0410 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0435,
      \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E
      \u043F\u0443\u0441\u0442\u043E\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442, \u0447\u0442\u043E \u043E\u043D\u0430
      \u2014 \u043F\u0443\u0441\u0442\u043E\u0442\u0430. \u0418 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0435\u0451 \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u043D\u044F\u043B.
      \u042D\u0442\u043E \u0438 \u0435\u0441\u0442\u044C \u044F.\xBB"
    LocalizationKey: dialogue_76b1aeff-df8b-4127-b85c-46af9de67d56
    OnEnter: {fileID: 0}
    Position: {x: 2661.6, y: 233.59999}
    Choices:
    - Text: "\u0410 \u043A\u0430\u043A \u0436\u0435 \u043D\u0430\u0448\u0430 \u0441\u0434\u0435\u043B\u043A\u0430?"
      LocalizationKey: choice_76b1aeff-df8b-4127-b85c-46af9de67d56_0
      TargetNodeGuid: 
    - Text: ...
      LocalizationKey: choice_76b1aeff-df8b-4127-b85c-46af9de67d56_1
      TargetNodeGuid: 
  - Guid: 74a9f62b-9c5b-4546-819f-d625ac44ce88
    Text: "\u041C\u043E\u043D\u0441\u0442\u0440 (\u0441 \u0438\u0437\u0434\u0435\u0432\u043A\u043E\u0439):
      \xAB\u0425\u043E\u0447\u0435\u0448\u044C \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C
      \u043C\u0435\u043D\u044F \u044D\u0442\u0438\u043C\u0438 \u043A\u0440\u043E\u0445\u043E\u0442\u043D\u044B\u043C\u0438
      \u0440\u044B\u0431\u0451\u0448\u043A\u0430\u043C\u0438? \u042D\u0442\u043E\u0433\u043E
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442. \u0413\u043E\u043B\u043E\u0434
      \u0441\u043C\u0435\u043D\u0438\u043B\u0441\u044F \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u043E\u043C.
      \u0410\u043F\u043F\u0435\u0442\u0438\u0442\u043E\u043C \u043D\u0430 \u0446\u0435\u043B\u043E\u0435.
      \u041D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u044C. \u041D\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044E.
      \u041D\u0430 \u0442\u0435\u0431\u044F. \u0417\u0430\u0432\u0442\u0440\u0430
      \u043C\u044B \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C \u043E
      \u0442\u0432\u043E\u0451\u043C \u0432\u043A\u043B\u0430\u0434\u0435 \u0432
      \u043D\u0430\u0448\u0435\u2026 \u043E\u0431\u0449\u0435\u0435 \u0434\u0435\u043B\u043E.\xBB"
    LocalizationKey: dialogue_74a9f62b-9c5b-4546-819f-d625ac44ce88
    OnEnter: {fileID: 0}
