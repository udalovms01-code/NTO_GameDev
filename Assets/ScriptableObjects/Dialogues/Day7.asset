  nodes:
  - Guid: 2f99c16f-605e-40bb-a571-f5f854748d8c
    Text: "\u0412\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435, \u0447\u0442\u043E
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u043E \u043D\u043E\u0447\u044C\u044E,
      \u043D\u043E \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u0435\u0442\u0435
      \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0435 \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u0435.
      \u0412\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
      \u0441\u0435\u0431\u044F \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443
      \u0436\u0438\u0432\u044B\u043C. \u041F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u0442\u0440\u0435\u0449\u0438\u043D\u044B
      \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0439 \u043F\u0430\u043B\u0443\u0431\u044B
      \u0441\u0432\u0435\u0442 \u043F\u043E\u0434\u0430\u0451\u0442 \u0432\u0430\u043C
      \u043D\u0430\u0434\u0435\u0436\u0434\u0443 \u043D\u0430 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\u0435
      \u0431\u0443\u0434\u0443\u0449\u0435\u0435."
    LocalizationKey: dialogue_2f99c16f-605e-40bb-a571-f5f854748d8c
    OnEnter: {fileID: 0}
    Position: {x: -299.2, y: -480}
    Choices:
    - Text: "\u041F\u043E\u0434\u044B\u0448\u0430\u0442\u044C \u043D\u0430 \u0432\u043E\u0437\u0434\u0443\u0445\u0435.
