  - key: dialogue_4ec0ba1c-ea43-4cd5-90e8-2c0f09f2e542
    category: 
    russian: "\u042F? \u041D\u0438\u0447\u0435\u0433\u043E. \u042F \u043B\u0438\u0448\u044C
      \u043F\u043E\u043A\u0430\u0436\u0443 \u0442\u0435\u0431\u0435, \u0447\u0442\u043E
      \u0442\u044B \u0443\u0436\u0435 \u0441\u0434\u0435\u043B\u0430\u043B \u0441
      \u0441\u043E\u0431\u043E\u0439. \u042F \u2014 \u0442\u0432\u043E\u0451 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043D\u0430\u0434\u043E\u0435\u043B\u043E
      \u0431\u044B\u0442\u044C \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u043C."
    english: 'I? '
  - key: dialogue_a4f8b9c2-07d0-4953-9eae-3e5f74aef846
    category: 
    russian: "\u0422\u0438\u0448\u0438\u043D\u0430? \u042F \u0441\u043B\u044B\u0448\u0443,
      \u043A\u0430\u043A \u0432 \u043D\u0435\u0439 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u043A\u043E\u0441\u0442\u044C. \u041A\u0430\u043A \u043F\u0443\u043B\u044C\u0441\u0438\u0440\u0443\u0435\u0442
      \u0432\u0435\u043D\u0430 \u043D\u0430 \u0432\u0438\u0441\u043A\u0435. \u042D\u0442\u043E
      \u043D\u0435 \u0442\u0438\u0448\u0438\u043D\u0430. \u042D\u0442\u043E \u2014
      \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435."
    english: 'Silence? '
  - key: dialogue_0506613a-646e-4114-b07f-38bd810e5073
    category: 
    russian: "\u041E\u0434\u0438\u043D \u0432 \u043E\u043A\u0435\u0430\u043D\u0435\u2026
      \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430\u0435\u0434\u0438\u043D\u0435 \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438
      \u043C\u044B\u0441\u043B\u044F\u043C\u0438. \u041E\u043D\u0438 \u0433\u0440\u043E\u043C\u043A\u0438\u0435.
      \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043E\u0434\u043D\u0430."
    english: 'Alone in the ocean... An ideal place to be alone with your thoughts. '
  - key: dialogue_83bfd8af-e846-43be-b094-bd0ea736cba2
    category: 
    russian: "\u0410, \u0434\u0430. \u0417\u0430\u043F\u043B\u0430\u0442\u0438 \u0437\u0430
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435. \u041E\u0442\u043A\u0443\u043F\u0438\u0441\u044C.
      \u0421\u0442\u0430\u0440\u0430\u044F, \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F
      \u0442\u0430\u043A\u0442\u0438\u043A\u0430. \u0425\u043E\u0440\u043E\u0448\u043E.
      \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0437\u0430\u0432\u0442\u0440\u0430
      \u0440\u044B\u0431\u0443. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u043D\u0430\u0434\u043E\u043B\u0433\u043E \u043B\u0438 \u0442\u0435\u0431\u044F
      \u0445\u0432\u0430\u0442\u0438\u0442."
    english: 'Oh yes. '
